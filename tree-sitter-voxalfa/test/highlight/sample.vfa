---
; ^punctuation.delimiter

[$] repeat={true}

[^] p={1} | cre={3,6}

[S] d : r ! m : f | s : l ! t : `da+1 | - : -` ! ~ : ~
[T] d : r ! m : f | s : l ! t : `da+1 | - : -` ! ~ : ~
[A] d : r ! m : f | s : l ! t : `da+1 | - : -` ! ~ : ~
[B] d : r ! m : f | s : l ! t : `da+1 | - : -` ! ~ : ~
;                                 ^type.qualifier
;                                   ^number
;     ^operator
;         ^operator
;                                       ^constant.builtin
;                                                ^constant.builtin

[1] do `re` mi\(f a) so la ti do_o_o. ~ ~ <\>
[2] do `re` mi\(f a) so la ti do_o_o. ~ ~ <\> ; scream
;      ^punctuation.bracket
