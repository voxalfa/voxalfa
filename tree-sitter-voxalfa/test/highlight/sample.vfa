;; @version 0.1.0-alpha.3

;  ^ keyword

[#] title="Hello World"
;   ^ property
;          ^ string
[#] author={"Foo Bar","Jane Doe"}
;          ^ punctuation.bracket
[#] composer="Bob"
[#] verses={2}
[#] description="Lorem Ipsum."
[#] release={2026}

;            ^ number

[$] key={C} | time={4,4} | tempo={100} | voices={S,A,T,B}

---

[$] dynamics={p, cresc:4..7}

[S] |d    :r    !m    :f    |`s   :l`   !t    :-    |da+1 :-    !     :     ||
;                                                     ^ type.qualifier
;                                                       ^ number
;                                                          ^ constant.builtin
[A] |d    :r    !m    :f    |`s   :l`   !t    :-    |da+1 :-    !     :     ||
[T] |d    :r    !m    :f    |`s   :l`   !t    :-    |da+1 :-    !     :     ||
[B] |d    :r    !m    :f    |`s   :l`   !t    :-    |da+1 :-    !     :     ||

[1] do    `re`  mi\   (f a) so    la    ti_   i     do_   o.    ~     ~     @@
[2] do    `re`  mi\   (f a) so    la    ti_   i     do_   o.    ~     ~     @@ ; scream

;         ^ punctuation.bracket
;                     ^ punctuation.bracket
;                                                                     ^ constant.builtin
;                                                     ^ operator

--
